# SignalWire Configuration (Required)
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_TOKEN=your_token_here
# Space name only ("myspace") or full domain ("myspace.signalwire.com")
SIGNALWIRE_SPACE_NAME=your_space_here.signalwire.com

# Public base URL of this app (Required for SWML handler registration)
# SignalWire fetches SWML from {SWML_PROXY_URL_BASE}/swml, so it must be
# publicly reachable (your ngrok URL for local dev, or the deployed URL).
# On Dokku/Heroku, APP_URL is set automatically and used as a fallback.
SWML_PROXY_URL_BASE=https://your-public-url.example.com

# Basic auth credentials embedded in the SWML callback URL (Recommended)
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=your_secret_here

# Agent Configuration (Optional)
# Name of the Fabric resource to register; the dialable address becomes
# /public/{AGENT_NAME}. Use a distinct name (e.g. holyguacamole-dev) for
# local development so you don't repoint the production handler.
AGENT_NAME=holyguacamole
PORT=5000

# Post-Prompt Configuration (Optional)
# Set this to enable the post-conversation summary webhook
POST_PROMPT_URL=https://your-webhook-url.com/post-prompt
